  "license": "MIT",
  "name": "react-document-pip",
  "description": "This is a simple utility package for document picture in picture",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KangBit/react-document-pip.git"
  },
  "bugs": {
    "url": "https://github.com/KangBit/react-document-pip/issues"
  },
  "keywords": [
    "react-pip",
    "react-document-pip",
    "react document pip",
    "pip",
    "document pip",
    "picture in picture"
  ],
  "homepage": "https://kangbit.github.io/posts/document-pip/react.html",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:clean": "rm -rf dist && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:clean"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ]
